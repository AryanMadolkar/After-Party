# =============================================================================
# After Party — environment variables
# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real secrets.
# =============================================================================

# --- Database (Neon Postgres) --------------------------------------------
# Get this from your Neon project dashboard: https://console.neon.tech
DATABASE_URL=

# --- Authentication (custom email/password + OAuth — see lib/auth/) --------
# No env var needed for email/password auth — it's self-contained.
# Google sign-in is optional; the button simply fails with a clear error if
# these aren't set. See README.md for how to obtain them.

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- File storage (Vercel Blob) --------------------------------------------
# Get this from your Vercel project's Storage tab.
BLOB_READ_WRITE_TOKEN=

# --- AI providers (prepared, not required for the mocked foundation) -------
# Leave empty until the real analysis/caption/music pipeline is implemented.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
