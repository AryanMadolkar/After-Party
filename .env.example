# =============================================================================
# After Party — environment variables
# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real secrets.
# =============================================================================

# --- Database (Neon Postgres) --------------------------------------------
# Get this from your Neon project dashboard: https://console.neon.tech
DATABASE_URL=

# --- Authentication (Clerk) ------------------------------------------------
# Get these from your Clerk dashboard: https://dashboard.clerk.com
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional: override Clerk's default routes (defaults match this app's routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# --- File storage (Vercel Blob) --------------------------------------------
# Get this from your Vercel project's Storage tab.
BLOB_READ_WRITE_TOKEN=

# --- AI providers (prepared, not required for the mocked foundation) -------
# Leave empty until the real analysis/caption/music pipeline is implemented.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
